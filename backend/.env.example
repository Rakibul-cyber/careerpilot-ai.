# CareerPilot AI — example environment variables.
# Copy to `.env` and fill real values. NEVER commit the real .env.
# core/config.py loads these via Pydantic Settings.

# --- Application ---
APP_NAME=CareerPilot AI
ENVIRONMENT=development
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=careerpilot
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://careerpilot:change_me@db:5432/careerpilot

# --- Security ---
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
