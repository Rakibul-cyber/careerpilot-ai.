# CareerPilot AI — example environment variables.
# Copy to `.env` and fill real values. NEVER commit the real .env.
# core/config.py loads these via Pydantic Settings.

# --- Application ---
APP_NAME=CareerPilot AI
ENVIRONMENT=development
# Production-safe default. Set DEBUG=true only for local debugging.
DEBUG=false

# --- API ---
API_V1_PREFIX=/api/v1

# --- CORS ---
# Comma-separated origins allowed to call the API from browsers.
# Use explicit origins in production. Never use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ALLOWED_HEADERS=Authorization,Content-Type

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careerpilot
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Active URL (used by settings.DATABASE_URL) — host runs against localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerpilot
# Reference URL for the containerized API — Postgres is reachable at host "db".
DOCKER_DATABASE_URL=postgresql://postgres:postgres@db:5432/careerpilot

# --- Security ---
# JWT signing key — generate a long random value for production.
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Scheduler ---
# Disabled by default; enable explicitly in deployments that should run jobs.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Europe/Berlin

# --- Uploads ---
# Local directory for uploaded resume files; per-resume size cap in MB.
UPLOAD_DIR=uploads
MAX_RESUME_UPLOAD_MB=5

# --- AI (Anthropic Claude) ---
# API key for AI features (resume parser, cover letters, interview prep).
# Optional at startup — if unset, AI operations fail cleanly when used while
# the rest of the app continues to run.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
AI_PARSER_MAX_TOKENS=4096
AI_COVER_LETTER_MAX_TOKENS=2048
AI_INTERVIEW_PREPARATION_MAX_TOKENS=4096

# --- Embeddings (OpenAI — semantic search, M31) ---
# Optional at startup; if unset, embedding ops fail cleanly. EMBEDDING_DIMENSIONS
# must match the DB vector column (1536 for text-embedding-3-small).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
