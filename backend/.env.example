# CareerPilot AI — example environment variables.
# Copy to `.env` and fill real values. NEVER commit the real .env.
# core/config.py loads these via Pydantic Settings.

# --- Application ---
APP_NAME=CareerPilot AI
ENVIRONMENT=development
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=careerpilot
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Active URL (used by settings.DATABASE_URL) — host runs against localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerpilot
# Reference URL for the containerized API — Postgres is reachable at host "db".
DOCKER_DATABASE_URL=postgresql://postgres:postgres@db:5432/careerpilot

# --- Security ---
# JWT signing key — generate a long random value for production.
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Scheduler ---
# Disabled by default; enable explicitly in deployments that should run jobs.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Europe/Berlin

# --- Uploads ---
# Local directory for uploaded resume files; per-resume size cap in MB.
UPLOAD_DIR=uploads
MAX_RESUME_UPLOAD_MB=5

# --- AI (Anthropic Claude) ---
# API key for the resume parser. Optional at startup — if unset, parsing fails
# cleanly (parse_status=failed) but the rest of the app runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
AI_PARSER_MAX_TOKENS=4096
